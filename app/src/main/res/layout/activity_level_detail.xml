<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5EFFF"
    android:padding="16dp">

    <!-- 🔥 Streak at Top -->
    <TextView
        android:id="@+id/tvStreakDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 Streak: 0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Level Title and Question Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp">

        <!-- Level Title -->
        <TextView
            android:id="@+id/tvLevelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Level 1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Question -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sample Question"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp" />

        <!-- Recognized Speech / Feedback -->
        <TextView
            android:id="@+id/tvSpeechResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗣 You said: ..."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvCorrected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Corrected Sentence"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Tips"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Fluency Score -->
        <TextView
            android:id="@+id/tvFluency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗣 Fluency Score: 0/100"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />


    </LinearLayout>

    <!-- Spacer to push buttons to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Footer with Mic Button and Next Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5EFFF"
        android:elevation="8dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/round_button_bg"
            android:src="@drawable/ic_mic"
            android:contentDescription="Start Speech Recognition"
            android:layout_marginBottom="16dp"
            android:tint="#FFFFFF" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:padding="12dp"
            android:textSize="18sp"
            android:backgroundTint="#6C63FF"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
