<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FF"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvGrammarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📧 Grammar MCQ Passage"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2C3250"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Passage will appear here"
        android:textSize="18sp"
        android:textColor="#2C3250"
        android:layout_below="@id/tvGrammarTitle"
        android:padding="12dp"
        android:background="#E8EBF8"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/llOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvExercise"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:padding="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔊 Replay Passage"
        android:layout_below="@id/llOptions"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        app:cornerRadius="16dp"
        android:backgroundTint="@color/teal_700"
        android:textColor="@android:color/white" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_below="@id/llOptions"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:enabled="false"
        app:cornerRadius="16dp"
        android:backgroundTint="@color/purple_500"
        android:textColor="@android:color/white"/>
</RelativeLayout>
